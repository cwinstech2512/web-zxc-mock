# This legacy webpack project reads these shell environment variables at build time.
# Real API mode is the default.
WEB_USE_MOCK=false

# Optional artificial latency in milliseconds while using mock mode.
WEB_MOCK_DELAY=120

# Required together with WEB_USE_MOCK=true for an intentional production demo build.
# Never set this in a real production deployment.
ALLOW_PRODUCTION_MOCK=false
